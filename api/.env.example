PORT=4000
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-hackathon-demo"
EVIDENCE_KEY="32-byte-or-longer-secret-for-file-encryption"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
WEB_ORIGIN="http://localhost:3000"

# Vercel (set these in the project Environment Variables):
# JWT_SECRET=a-long-random-string
# EVIDENCE_KEY=a-long-random-string
# WEB_ORIGIN=https://your-safenest-web.vercel.app
# DATABASE_URL can be omitted on Vercel — the API creates a SQLite file in /tmp for the demo.
# Leave OPENAI_API_KEY empty to use the local safety classifier.
